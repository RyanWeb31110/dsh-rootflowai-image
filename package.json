{
  "name": "dsh-rootflowai-image",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that generates article illustrations through RootFlowAI's count-based image API and saves them for hand publish.",
  "type": "module",
  "license": "MIT",
  "author": "QingShanLab (https://github.com/QingShanLab)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rootflowai",
    "image-generation",
    "qingshan"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-rootflowai-image-gen": "./lib/cli.js"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "locale",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
